# Forms Gamkers - cPanel / Passenger production settings.
# Copy to `.env` in the project directory (never inside public_html) and fill in
# every value. Never commit the filled-in file. Alternatively, enter the same keys
# as environment variables in cPanel > Setup Python App.

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up: encrypted SMTP passwords cannot be recovered without it.
SMTP_ENCRYPTION_KEY=

# Canonical HTTPS origin, no trailing slash. Used for password-reset and invitation links.
APPLICATION_BASE_URL=https://forms.example.com

# cPanel prefixes database and user names with your cPanel username.
# URL-encode the password first (every special character must be encoded):
# python -c "import getpass, urllib.parse; print(urllib.parse.quote(getpass.getpass('DB password: '), safe=''))"
# If TCP to localhost is refused, append &unix_socket=/var/lib/mysql/mysql.sock
DATABASE_URL=mysql+pymysql://CPANELUSER_DBUSER:URL_ENCODED_PASSWORD@localhost/CPANELUSER_DBNAME?charset=utf8mb4

SECURE_COOKIES=1

# memory:// limits are per process. Use a shared Redis URL if the host offers one
# (requires installing the `redis` package).
RATELIMIT_STORAGE_URI=memory://

# Optional platform SMTP fallback (organisation SMTP takes precedence)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=no-reply@example.com
# SMTP_SECURITY=starttls
