SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SENDER=no-reply@example.com
SMTP_SECURITY=starttls
