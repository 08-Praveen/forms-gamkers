SECRET_KEY=replace-with-generated-secret-key
SMTP_ENCRYPTION_KEY=replace-with-generated-fernet-key
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_formsdb
DB_USER=cpaneluser_formsuser
DB_PASSWORD=replace-with-cpanel-database-password
APPLICATION_BASE_URL=http://localhost:5000
SECURE_COOKIES=0
RATELIMIT_STORAGE_URI=memory://
